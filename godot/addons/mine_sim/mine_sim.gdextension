[configuration]

entry_symbol = "mine_sim_init"
compatibility_minimum = 4.1

[libraries]

linux.debug.x86_64 = "bin/libmine_sim.linux.x86_64.so"
linux.release.x86_64 = "bin/libmine_sim.linux.x86_64.so"
windows.debug.x86_64 = "bin/mine_sim.windows.x86_64.dll"
windows.release.x86_64 = "bin/mine_sim.windows.x86_64.dll"
