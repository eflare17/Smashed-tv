extends RefCounted
## Gothica's extra life: carrying, putting her down, the lounge walls, the throw, the pool, the watching.

func run(t) -> void:
	var ll: LobbyLife = t.ll
	var gl: GothLife = ll.things["goth_life"]
	var pool: LobbyPool = ll.things["pool"]
	var p: Player = ll.player
	var goth: Gothica = ll.gothica
	var g := pool.tower_geo()
	# --- who can carry
	t.check(GothLife.is_carrier(p) and p.char_id == "juicy", "Juicy can carry")
	p.char_id = "tyson2"
	goth.place(300, 300)
	t.place(320, 300)
	await t.wait(0.1)
	t.check(not gl.can_carry(p) and t.label() != "PICK UP", "Tyson cannot carry her")
	p.char_id = "juicy"
	# --- pick up
	goth.visible = true
	t.place(400, 330)
	goth.place(300, 300)
	await t.wait(0.1)
	t.check(not gl.can_carry(p) and t.label() != "PICK UP", "not when she is far (100)")
	t.place(320, 300)
	await t.wait(0.1)
	t.check(gl.can_carry(p), "can carry when near")
	t.check(t.label() == "PICK UP", "E says PICK UP (%s)" % t.label())
	t.press_e()
	t.check(gl.carrying(p) and p.get_meta("carrying_goth", false), "E picks her up (meta carrying_goth)")
	t.check(gl.held and gl.is_busy(), "she is held, busy")
	t.check(not goth.visible, "her own figure is hidden: she is in his arms")
	t.check(ll.pose_of(p) != null, "he is drawn with her in his arms")
	t.check(not p.controls_enabled, "he stands still for the pick-up")
	await t.wait(0.5)
	t.check(p.controls_enabled and gl.anim.is_empty(), "free again after 0.34 s")
	t.check(t.label() == "PUT DOWN", "E says PUT DOWN (%s)" % t.label())
	# --- no rolling, walking about with her
	Input.action_press("roll")
	await t.wait(0.3)
	Input.action_release("roll")
	t.check(p.roll <= 0.0, "no rolling while he carries her")
	t.place(320, 300)
	await t.hold("move_right", 0.5)
	t.check(p.html_pos().x > 340.0, "walks about")
	t.check(goth.global_position.distance_to(p.global_position) < 0.4, "she is where he is")
	# --- she lives in the lounge: the back door to the yard is shut to him
	t.place(645, 480)
	await t.hold("move_down", 1.5)
	t.check(p.html_pos().y < 489.0, "can't go out the back door with her (y %.1f)" % p.html_pos().y)
	# --- put her down
	t.place(320, 300, Vector2(1, 0))
	p.facing = Vector2(1, 0)
	gl.face = false
	await t.wait(0.1)
	t.press_e()
	t.check(not gl.anim.is_empty() and gl.carrying(p), "E starts the set-down")
	await t.wait(0.5)
	t.check(not gl.carrying(p) and not p.get_meta("carrying_goth", false), "she's put down")
	t.check(goth.visible and not gl.held, "she's back to wandering")
	var gp := LobbyLife.hpos(goth)
	t.check(gp.x > 70.0 and gp.x < 590.0 and gp.y > 249.0 and gp.y < 411.0, "set down inside her area (%.0f, %.0f)" % [gp.x, gp.y])
	t.check(ll.pose_of(p) == null, "his own picture is back")
	# --- up the tower with her, the throw from the board, the pool
	goth.place(g.ladderX + 5, 214.0)
	t.place(g.ladderX, 214.0, Vector2(0, -1))
	await t.wait(0.1)
	t.press_e()
	await t.wait(0.5)
	t.check(gl.carrying(p), "picked her up at the ladder foot")
	t.check(t.label() != "PICK UP" and t.label() != "", "(the label is %s)" % t.label())
	Input.action_press("move_up")
	await t.wait(0.4)
	t.check(pool.dive_of(p) == LobbyPool.Dive.CLIMB and gl.carrying(p), "climbs with her in his arms")
	t.check(ll.pose_of(p) != null, "still drawn carrying her")
	t.press_e()
	t.check(gl.carrying(p), "E on the ladder does nothing")
	await t.wait(1.2)
	Input.action_release("move_up")
	t.check(pool.dive_of(p) == LobbyPool.Dive.BOARD, "on the board")
	t.check(t.label() == "THROW!", "E says THROW! (%s)" % t.label())
	await t.hold("move_right", 0.3)
	Input.action_press("roll")
	await t.wait(0.4)
	Input.action_release("roll")
	t.check(pool.dive_of(p) == LobbyPool.Dive.BOARD, "can't roll off the board with her")
	t.press_e()
	t.check(not gl.carrying(p) and gl.thrown == "air", "E throws her in (%s)" % gl.thrown)
	t.check(not p.get_meta("carrying_goth", false), "no longer carrying")
	t.check(pool.dive_of(p) == LobbyPool.Dive.BOARD, "he stays on the board")
	await t.wait(0.3)
	t.check(gl._t_z > 0.0 and gl.is_busy(), "she is in the air and busy")
	await t.wait(1.0)
	t.check(gl.thrown == "swim", "she lands in the water and swims (%s)" % gl.thrown)
	t.check(LobbyPool.in_water(gl._t_pos.x, gl._t_pos.y), "in the water (%.0f, %.0f)" % [gl._t_pos.x, gl._t_pos.y])
	t.check(gl.swimmer_info().has("x"), "the ducks mind her")
	t.check(pool.fx.foams.size() > 0, "she made a splash")
	t.check(gl.pos().distance_to(Vector2(gl._t_pos.x, gl._t_pos.y)) < 1.0, "her figure is at her place")
	t.check(not gl.can_carry(p), "can't be picked up while swimming")
	await t.wait(3.6)
	t.check(gl.thrown == "" and not gl.held, "after 3.5 s she climbs out")
	var gp2 := LobbyLife.hpos(goth)
	t.check(absf(gp2.y - 257.0) < 3.0, "over the near edge, y 257 (%.1f)" % gp2.y)
	t.check(pool.fx.is_wet("goth"), "she drips")
	# --- the dive with her: walking off the tip drops her too
	# (the player is still on the board)
	t.check(pool.dive_of(p) == LobbyPool.Dive.BOARD, "he is still up there")
	await t.hold("move_left", 1.0)
	await t.hold("move_down", 1.5)
	t.check(not ll.busy.has(p), "walked back and down the ladder, off")
	# pick her up where she stands and walk her off the tip
	goth.place(g.ladderX + 5, 214.0)
	goth.set("wait", 5.0)
	t.place(g.ladderX, 214.0, Vector2(0, -1))
	await t.wait(0.1)
	t.press_e()
	await t.wait(0.5)
	t.check(gl.carrying(p), "carrying again")
	await t.hold("move_up", 1.5)
	t.check(pool.dive_of(p) == LobbyPool.Dive.BOARD and gl.carrying(p), "on the board with her again")
	Input.action_press("move_right")
	await t.wait(1.3)
	Input.action_release("move_right")
	t.check(not gl.carrying(p) and gl.thrown != "", "walking off the tip throws her with him (%s)" % gl.thrown)
	await t.wait(1.0)
	t.check(pool.swimming(p) and gl.thrown == "swim", "both in the water")
	# get him out and wait for her to get out
	await t.hold("move_down", 2.5)
	await t.wait(3.5)
	t.check(gl.thrown == "", "she is out too")
	# --- a throw to the left lands on the floor
	goth.place(g.ladderX + 5, 214.0)
	goth.set("wait", 9.0)
	t.place(g.ladderX, 214.0, Vector2(0, -1))
	await t.wait(0.1)
	t.press_e()
	await t.wait(0.5)
	await t.hold("move_up", 1.5)
	await t.hold("move_right", 0.1)
	await t.hold("move_left", 0.15)
	p.facing = Vector2(-1, 0)
	pool._s[p].fx = -1.0
	t.press_e()
	await t.wait(1.0)
	t.check(gl.thrown == "floor" or gl.thrown == "", "thrown to the left she lands on the floor (%s)" % gl.thrown)
	await t.wait(2.3)
	t.check(gl.thrown == "" and not gl.held, "and gets up")
	# --- watching a lift: the gym's rep signal (here told directly; without a gym that can say lifting(p) he is
	# taken to be lifting for 4 s after the last rep)
	var gym = ll.things["gym"]
	if gym.has_method("lifting"):
		t.check(true, "(a real gym: watching is driven by its signal)")
		return
	goth.place(200, 350)
	goth.set("wait", 0.0)
	gl._on_rep(p, "bench", 2)
	await t.wait(0.3)
	t.check(gl.claimed_by() == "watch", "from the second rep she comes to watch")
	await t.wait(3.0)
	var d := LobbyLife.hpos(goth).distance_to(Vector2(478, 154))
	t.check(d < 8.0, "she walks to the bench's watch spot (%.1f away)" % d)
	t.check(ll.ui.saying(goth) == "", "no word before 5 reps")
	gl._on_rep(p, "bench", 5)
	await t.wait(0.3)
	t.check(ll.ui.saying(goth) == "Wow, you're really strong!", "at 5 reps: Wow, you're really strong!")
	await t.wait(4.5)
	t.check(gl.claimed_by() == "", "when he's done she stops watching")
